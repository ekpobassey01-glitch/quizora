[{"q":"Economics is the study of","a":"Money only","b":"Scarcity and choice","c":"Wealth only","d":"Banking only","correct":"B","exp":"Scarcity and choice"},{"q":"The basic economic problem is","a":"Unemployment","b":"Inflation","c":"Scarcity","d":"Poverty","correct":"C","exp":"Scarcity"},{"q":"Opportunity cost is","a":"Money cost","b":"Next best alternative forgone","c":"Total cost","d":"Fixed cost","correct":"B","exp":"Next best alternative"},{"q":"A production possibility curve shows","a":"Demand","b":"Maximum output combinations","c":"Supply","d":"Price","correct":"B","exp":"PPC"},{"q":"If PPC shifts outward, it means","a":"Recession","b":"Economic growth","c":"Inflation","d":"Unemployment","correct":"B","exp":"Growth"},{"q":"A point inside PPC means","a":"Efficiency","b":"Unemployment / inefficiency","c":"Growth","d":"Full employment","correct":"B","exp":"Inside = inefficiency"},{"q":"The law of demand states, ceteris paribus, price up, quantity demanded","a":"Rises","b":"Falls","c":"Stays same","d":"Doubles","correct":"B","exp":"Inverse relationship"},{"q":"An increase in demand is shown by","a":"Movement along curve","b":"Shift right","c":"Shift left","d":"No change","correct":"B","exp":"Shift right"},{"q":"A fall in price of substitute will cause demand for a good to","a":"Rise","b":"Fall","c":"Stay","d":"Double","correct":"B","exp":"Substitute cheaper → demand falls"},{"q":"Complementary goods: price of petrol rises, demand for cars will","a":"Rise","b":"Fall","c":"Stay","d":"Double","correct":"B","exp":"Complements move together"},{"q":"Price elasticity of demand =","a":"%ΔQ / %ΔP","b":"%ΔP / %ΔQ","c":"Q / P","d":"P / Q","correct":"A","exp":"% change Q / % change P"},{"q":"If demand is elastic, price rise will cause total revenue to","a":"Rise","b":"Fall","c":"Stay","d":"Double","correct":"B","exp":"Elastic: revenue falls when price rises"},{"q":"If demand is inelastic, price rise will cause total revenue to","a":"Rise","b":"Fall","c":"Stay","d":"Zero","co